# Resume Contact Information (injected into the PDF routes at generation time)
RESUME_NAME="Name"
RESUME_EMAIL="email@example.com"
RESUME_PHONE="+1 123-456-7890"
RESUME_LINKEDIN="linkedin.com/in/ryanmenner"
RESUME_GITHUB="github.com/rmenner"
RESUME_WEBSITE="ryanmenner.com"
RESUME_LOCATION="City, ST"

# Resume role variant. Each role lives in src/data/roles/*.json and sets the headline,
# summary, and bullet selection/order. The compiler (src/lib/resume.js) renders it for
# the web, fancy, and ats channels. Options:
#   design-systems-engineer (default) | frontend-platform | senior-frontend | ui-engineer
# Set here to change the dev server's default, OR pass per run to the generator:
#   npm run pdf -- --target=ui-engineer      (fancy/designed PDF)
#   npm run pdf:ats -- --target=ui-engineer  (ats PDF)
#   /resume/fancy?target=ui-engineer         (in the browser)
#RESUME_ROLE="design-systems-engineer"

# Optional per-application overrides for the PRINT resumes (fancy AND ats — they share
# the same content, so these keep them matched). Leave empty to use the role's wording.
#RESUME_ATS_HEADLINE="UI Engineer"
#RESUME_ATS_OVERVIEW="Frontend engineer with 10+ years building user interfaces, now focused on complex, accessible UI components for enterprise applications."
